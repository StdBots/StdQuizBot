{
  "name": "StdQuizBot",
  "description": "Enterprise Telegram Quiz & Trivia Bot built in Go. Flawless Solo DM & Multiplayer Group Tournaments, Native Quiz Polls, Speed-Based Scoring, and HD Victory Podium Banners.",
  "repository": "https://github.com/StdBots/StdQuizBot",
  "logo": "https://graph.org/file/00ea4effe5d2dfbb8d5be.jpg",
  "keywords": [
    "telegram",
    "bot",
    "golang",
    "quizbot",
    "trivia",
    "polls",
    "multiplayer",
    "group-tournament",
    "mongodb",
    "stdbots",
    "std-deepanshu"
  ],
  "stack": "container",
  "env": {
    "BOT_TOKEN": {
      "description": "Telegram Bot Token from @BotFather",
      "required": true
    },
    "OWNER_ID": {
      "description": "Telegram Numeric User ID of the Bot Owner",
      "value": "7394590844",
      "required": true
    },
    "MONGO_URI": {
      "description": "MongoDB Connection String (Atlas or Local)",
      "required": true
    },
    "DB_NAME": {
      "description": "Database Name",
      "value": "stdquizbot",
      "required": false
    },
    "FORCE_SUB_CHANNEL": {
      "description": "Channel username for force subscription (without @)",
      "value": "StdBots",
      "required": false
    },
    "LOG_CHANNEL_ID": {
      "description": "Channel ID for audit logs (optional, e.g. -1001234567890)",
      "value": "0",
      "required": false
    },
    "ENV": {
      "description": "Runtime Environment",
      "value": "production",
      "required": false
    }
  },
  "formation": {
    "worker": {
      "quantity": 1,
      "size": "eco"
    }
  }
}
